c c 4x4 Sudoku, pairwise encoding, two clues, variables renamed.
c c RUN: %solver %s | %OutputCheck %s --check-prefix=DIRECT
c c RUN: %solver --placementbudget 0 %s | %OutputCheck %s --check-prefix=FALLBACK
c c RUN: %solver --placementcnt 0 %s | %OutputCheck %s --check-prefix=NORMAL
c c DIRECT: \[placement\].*counted
c c DIRECT: ^c s exact arb int 12$
c c FALLBACK: over budget, counting normally
c c FALLBACK: ^c s exact arb int 12$
c c NORMAL-NOT: \[placement\]
c c NORMAL: ^c s exact arb int 12$
p cnf 64 450
