c c Projected count of the same 4x4-grid instance over {1,2,3,4} = 8 (brute-forced).
c c RUN: %solver %s | %OutputCheck %s --check-prefix=INT
c c RUN: %solver --arjun 0 %s | %OutputCheck %s --check-prefix=INT
c c RUN: %solver --cache 0 %s | %OutputCheck %s --check-prefix=INT
c c RUN: %solver --threads 4 %s | %OutputCheck %s --check-prefix=INT
c c RUN: %solver --restart 1 --td 0 %s | %OutputCheck %s --check-prefix=INT
c c RUN: %solver --stripoptindep 1 %s | %OutputCheck %s --check-prefix=INT
c t pmc
c p show 1 2 3 4 0
p cnf 16 24
-1 -2 0
-1 -5 0
-2 -3 0
-2 -6 0
-3 -4 0
-3 -7 0
-4 -8 0
-5 -6 0
-5 -9 0
-6 -7 0
-6 -10 0
-7 -8 0
-7 -11 0
-8 -12 0
-9 -10 0
-9 -13 0
-10 -11 0
-10 -14 0
-11 -12 0
-11 -15 0
-12 -16 0
-13 -14 0
-14 -15 0
-15 -16 0
c c INT: ^s SATISFIABLE$
c c INT: ^c s type pmc$
c c INT: ^c s exact arb int 8$
