c c Projected weighted count over the shown vars {1,2,3} = 11/30 (brute-forced):
c c the weights of the projected-out vars {4,5,6} must NOT enter the product.
c c RUN: %solver --mode 1 %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %solver --mode 1 --cache 0 %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %solver --mode 1 --arjun 0 %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %solver --mode 1 --threads 4 %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %solver --mode 7 %s | %OutputCheck %s --check-prefix=REALF
p cnf 6 6
c t pwmc
c p show 1 2 3 0
c p weight 1 1/2 0
c p weight 2 1/3 0
c p weight 3 2/5 0
c p weight 4 3/7 0
c p weight 5 1/4 0
c p weight 6 5/6 0
1 2 0
-1 3 0
-2 -3 4 0
3 5 -6 0
-4 -5 0
6 1 0
c c FRAC: ^s SATISFIABLE$
c c FRAC: ^c s type pwmc$
c c FRAC: ^c s exact arb frac 11/30$
c c REALF: ^c s exact quadruple float 3\.66666667e-01$
