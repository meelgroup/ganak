c c d-DNNF compile in weighted mode: Ganak must still report the weighted count
c c (143/840) while the emitted circuit is the unweighted structure -- its model
c c count is the plain model count (10), not the weighted one.
c c RUN: %solver --mode 1 --compile %t.nnf %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %ddnnf_verify %t.nnf --cnf %s --expect-count 10 --no-strict
c c RUN: %ddnnf_cleanup %t.nnf %t.clean.nnf
c c RUN: %ddnnf_verify %t.clean.nnf --cnf %s --expect-count 10 --check-decomposable --strict
p cnf 6 6
c t wmc
c p weight 1 1/2 0
c p weight 2 1/3 0
c p weight 3 2/5 0
c p weight 4 3/7 0
c p weight 5 1/4 0
c p weight 6 5/6 0
1 2 0
-1 3 0
-2 -3 4 0
3 5 -6 0
-4 -5 0
6 1 0
c c FRAC: ^s SATISFIABLE$
c c FRAC: ^c s exact arb frac 143/840$
