c c Weighted count over the rationals = 143/840 (brute-forced with Fraction).
c c Also pins the --mpfrprec ladder: the same value at 32/64/128/256 bits, with
c c the precision named in the output line.
c c RUN: %solver --mode 1 %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %solver --mode 1 --cache 0 %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %solver --mode 1 --threads 4 %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %solver --mode 1 --restart 1 %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %solver --mode 1 --arjun 0 --td 0 %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %solver --mode 7 --mpfrprec 32 %s | %OutputCheck %s --check-prefix=SINGLE
c c RUN: %solver --mode 7 --mpfrprec 64 %s | %OutputCheck %s --check-prefix=DOUBLE
c c RUN: %solver --mode 7 %s | %OutputCheck %s --check-prefix=QUAD
c c RUN: %solver --mode 7 --mpfrprec 256 %s | %OutputCheck %s --check-prefix=OCT
p cnf 6 6
c t wmc
c p weight 1 1/2 0
c p weight 2 1/3 0
c p weight 3 2/5 0
c p weight 4 3/7 0
c p weight 5 1/4 0
c p weight 6 5/6 0
1 2 0
-1 3 0
-2 -3 4 0
3 5 -6 0
-4 -5 0
6 1 0
c c FRAC: ^s SATISFIABLE$
c c FRAC: ^c s type wmc$
c c FRAC: ^c s exact arb frac 143/840$
c c SINGLE: ^c s exact single float 1\.70238095e-01$
c c DOUBLE: ^c s exact double float 1\.70238095e-01$
c c QUAD: ^c s exact quadruple float 1\.70238095e-01$
c c OCT: ^c s exact octuple float 1\.70238095e-01$
