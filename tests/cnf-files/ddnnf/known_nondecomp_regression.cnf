c c Decomposability regression: learnt clauses bridge vars of different
c c components, so propagation inside one component used to set a var of
c c another one, which leaked into the arc-lits (var 16 in two AND children).
c c The circuit must be decomposable as written.
c c
c c RUN: %solver --compile %t.bdnnf %s
c c RUN: %bdnnf verify %t.bdnnf --expect-count 5897 --check-decomposable
c c RUN: %bdnnf sample %t.bdnnf --cnf %s -n 300 -o %t.samples
p cnf 16 40
