c c d-DNNF compile: all variables free (the only clause is a tautology), so the
c c count is 2^3 = 8. Exercises the free-variable OR(v,-v) factor-of-two nodes.
c c RUN: %solver --compile %t.bdnnf %s
c c RUN: %ddnnf_verify %t.bdnnf --expect-count 8 --no-strict
c c RUN: %ddnnf_count %t.bdnnf --cnf %s --sample 300
c c RUN: %ddnnf_cleanup %t.bdnnf %t.clean.bdnnf
c c RUN: %ddnnf_verify %t.clean.bdnnf --expect-count 8 --check-decomposable --strict
c c RUN: %ddnnf2dot %t.clean.bdnnf %t.dot
p cnf 3 1
1 -1 0
