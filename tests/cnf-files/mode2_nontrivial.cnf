c c Complex rational weighted count = 1009/1440 - 881/10080i (brute-forced over
c c Gaussian rationals). Mode 6 is the same sum in MPFR floats.
c c RUN: %solver --mode 2 %s | %OutputCheck %s --check-prefix=CPX
c c RUN: %solver --mode 2 --cache 0 %s | %OutputCheck %s --check-prefix=CPX
c c RUN: %solver --mode 2 --arjun 0 --td 0 %s | %OutputCheck %s --check-prefix=CPX
c c RUN: %solver --mode 2 --threads 4 %s | %OutputCheck %s --check-prefix=CPX
c c RUN: %solver --mode 6 %s | %OutputCheck %s --check-prefix=CPXF
p cnf 6 6
c t wmc
c p weight 1 1/2+1i 0
c p weight 2 0+1/3i 0
c p weight 3 2/5-1/2i 0
c p weight 4 3/7+0i 0
c p weight 5 1/4+1/4i 0
c p weight 6 5/6-1/3i 0
1 2 0
-1 3 0
-2 -3 4 0
3 5 -6 0
-4 -5 0
6 1 0
c c CPX: ^s SATISFIABLE$
c c CPX: ^c s exact arb frac 1009/1440 \+ -881/10080i$
c c CPXF: ^c s exact quadruple float 7\.00694444e-01 \+ -8\.74007937e-02i$
