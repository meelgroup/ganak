c c One-hot 3-coloring of the 5-cycle: (k-1)^n + (-1)^n (k-1) = 30.
c c RUN: %solver %s | %OutputCheck %s --check-prefix=DIRECT
c c RUN: %solver --colornodes 0 %s | %OutputCheck %s --check-prefix=FALLBACK
c c RUN: %solver --colorcnt 0 %s | %OutputCheck %s --check-prefix=NORMAL
p cnf 15 35
