c c d-DNNF compile in weighted mode: Ganak must still report the weighted count
c c (143/840) while the emitted circuit is the unweighted structure -- its model
c c count is the plain model count (10), not the weighted one.
c c RUN: %solver --mode 1 --compile %t.bdnnf %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %bdnnf verify %t.bdnnf --expect-count 10 --check-decomposable
c c RUN: %bdnnf sample %t.bdnnf --cnf %s -n 300 -o %t.samples
c c RUN: python3 %S/../../bdnnf.py count %t.bdnnf --cnf %s | %OutputCheck %s --check-prefix=PYW
c c RUN: python3 %S/../../bdnnf.py check %t.bdnnf
c c RUN: printf 'count\nexit\n' | %bdnnf stream %t.bdnnf --cnf %s | %OutputCheck %s --check-prefix=STR
p cnf 6 6
c t wmc
c p weight 1 1/2 0
c p weight 2 1/3 0
c p weight 3 2/5 0
c p weight 4 3/7 0
c p weight 5 1/4 0
c p weight 6 5/6 0
1 2 0
-1 3 0
-2 -3 4 0
3 5 -6 0
-4 -5 0
6 1 0
c c FRAC: ^s SATISFIABLE$
c c FRAC: ^c s exact arb frac 143/840$
c c PYW: ^143/840$
c c STR: ^143/840$
c c STR: ^c done$
