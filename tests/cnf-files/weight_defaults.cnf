c c Weight-line defaulting rules, all three in one instance:
c c   var 1: only the positive weight given -> negative defaults to 1-w (2/3)
c c   var 2: both given and NOT summing to 1 -> both used verbatim
c c   var 3: no weight line at all -> weight 1 on both polarities
c c Hand-computed: 2/3 * (2/7 + 2/7 + 1/7) = 10/21.
c c RUN: %solver --mode 1 %s | %OutputCheck %s --check-prefix=FRAC
c c RUN: %solver --mode 1 --cache 0 --arjun 0 %s | %OutputCheck %s --check-prefix=FRAC
p cnf 3 2
c t wmc
c p weight 1 1/3 0
c p weight 2 2/7 0
c p weight -2 1/7 0
-1 0
2 3 0
c c FRAC: ^s SATISFIABLE$
c c FRAC: ^c s exact arb frac 10/21$
