c c Multivariate polynomial weighted count over two poly vars. Brute-forced:
c c x0^2*x1 + x0*x1^2 + 2*x0*x1 + 2*x1^2 + x1
c c RUN: %solver --mode 3 --npolyvars 2 %s | %OutputCheck %s --check-prefix=POLY
c c RUN: %solver --mode 3 --npolyvars 2 --cache 0 %s | %OutputCheck %s --check-prefix=POLY
c c RUN: %solver --mode 3 --npolyvars 2 --arjun 0 --td 0 %s | %OutputCheck %s --check-prefix=POLY
c c RUN: %solver --mode 3 --npolyvars 2 --threads 4 %s | %OutputCheck %s --check-prefix=POLY
p cnf 3 3
c t wmc
c p weight 1 x0 + 1 0
c p weight -1 1 0
c p weight 2 x1 0
c p weight -2 x0 + 1 0
c p weight 3 x1 + x0 0
c p weight -3 1 0
1 2 0
-1 3 0
2 -3 0
c c POLY: ^s SATISFIABLE$
c c POLY: ^c s exact poly x0\^2\*x1 \+ x0\*x1\^2 \+ 2\*x0\*x1 \+ 2\*x1\^2 \+ x1$
