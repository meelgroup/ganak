c c 2x2 Latin square; bigger shapes are covered by scripts/fuzz_placement.py
c c RUN: %solver %s | %OutputCheck %s --check-prefix=DIRECT
c c RUN: %solver --placementbudget 0 %s | %OutputCheck %s --check-prefix=FALLBACK
c c RUN: %solver --placementcnt 0 %s | %OutputCheck %s --check-prefix=NORMAL
c c DIRECT: \[placement\].*counted
c c DIRECT: ^c s exact arb int 2$
c c FALLBACK: over budget, counting normally
c c FALLBACK: ^c s exact arb int 2$
c c NORMAL-NOT: \[placement\]
c c NORMAL: ^c s exact arb int 2$
p cnf 8 24
1 2 0
-1 -2 0
3 4 0
-3 -4 0
5 6 0
-5 -6 0
7 8 0
-7 -8 0
1 3 0
-1 -3 0
2 4 0
-2 -4 0
5 7 0
-5 -7 0
6 8 0
-6 -8 0
1 5 0
-1 -5 0
2 6 0
-2 -6 0
3 7 0
-3 -7 0
4 8 0
-4 -8 0
