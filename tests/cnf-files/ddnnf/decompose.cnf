c c d-DNNF compile: two variable-disjoint sub-problems ({1,2} and {3,4}).
c c Exercises AND-node component decomposition; structural count = product.
c c RUN: %solver --compile %t.bdnnf %s
c c RUN: %bdnnf verify %t.bdnnf --expect-count 4 --check-decomposable
c c RUN: %bdnnf sample %t.bdnnf --cnf %s -n 300 -o %t.samples
c c RUN: %bdnnf dot %t.bdnnf %t.dot
p cnf 4 4
1 2 0
-1 2 0
3 4 0
-3 -4 0
