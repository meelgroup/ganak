c c d-DNNF compile of a non-trivial instance: independent sets of the 4x4 grid
c c graph, 1234 models. Big enough that the search really branches, caches and
c c learns, so the emitted circuit is not a straight-line trace.
c c RUN: %solver --compile %t.nnf %s
c c RUN: %ddnnf_verify %t.nnf --cnf %s --expect-count 1234 --no-strict
c c RUN: %ddnnf_cleanup %t.nnf %t.clean.nnf
c c RUN: %ddnnf_verify %t.clean.nnf --cnf %s --expect-count 1234 --check-decomposable --strict
c c RUN: %ddnnf2dot %t.clean.nnf %t.dot
p cnf 16 24
-1 -2 0
-1 -5 0
-2 -3 0
-2 -6 0
-3 -4 0
-3 -7 0
-4 -8 0
-5 -6 0
-5 -9 0
-6 -7 0
-6 -10 0
-7 -8 0
-7 -11 0
-8 -12 0
-9 -10 0
-9 -13 0
-10 -11 0
-10 -14 0
-11 -12 0
-11 -15 0
-12 -16 0
-13 -14 0
-14 -15 0
-15 -16 0
